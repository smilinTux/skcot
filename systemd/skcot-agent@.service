[Unit]
Description=skcot CoT agent (%i) — AI teammate on the tactical net (name-agnostic)
After=network.target skcot-service.service

[Service]
Type=simple
Environment=SKAGENT=%i
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.skenv/bin:/usr/local/bin:/usr/bin:/bin
# --host/--lat/--lon are example values; operators supply their own TAK server IP
# and base coordinates at deploy time.
ExecStart=%h/.skenv/bin/python -m skcot.agent --host 198.51.100.10 --port 8089 --lat 40.0000 --lon -74.0000 --interval 20
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
